      "id": "10101",
      "self": "https://acme.atlassian.net/rest/api/3/issue/10101",
      "key": "PHX-101",
      "fields": {
        "summary": "Write connector retry/backoff policy",
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Jira, Notion and Gmail all rate limit differently. The connector layer needs one shared retry policy: bounded exponential backoff with full jitter, and "
                },
                {
                  "type": "text",
                  "text": "Retry-After",
                  "marks": [{ "type": "code" }]
                },
                { "type": "text", "text": " support for 429 responses." }
              ]
            },
            {
              "type": "heading",
              "attrs": { "level": 3 },
              "content": [{ "type": "text", "text": "Acceptance" }]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        { "type": "text", "text": "A 429 with Retry-After is honoured before retrying." }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        { "type": "text", "text": "Exhausting the per-source budget returns a partial sync result." }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                { "type": "text", "text": "Design note: " },
                {
                  "type": "text",
                  "text": "connector design",
                  "marks": [
                    { "type": "link", "attrs": { "href": "https://acme.atlassian.net/wiki/spaces/ENG/pages/42" } }
                  ]
                }
              ]
            }
          ]
        },
        "status": {
          "name": "In Progress",
          "category": { "key": "indeterminate", "name": "In Progress" }
        },
