# Copy to .env and fill in. .env is git-ignored; never commit real values.
#
# The app reads these through pydantic-settings (src/config.py). Every field
# below is optional: unset fields fall back to the dev defaults defined there.

# --- App ---------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- Database ----------------------------------------------------------
# Leave unset to run the API without a database (tracing degrades to a no-op
# sink and /health reports database.reachable=false).
# psycopg reads PGPASSWORD from the environment, so a password never has to
# appear in this URL.
DATABASE_URL=postgresql+psycopg://rag@localhost:5432/agentic_rag
DB_ECHO=false
DB_CONNECT_TIMEOUT_S=5

# --- Audit -------------------------------------------------------------
# true = refuse the request (503) rather than answer without an audit record.
# Dev may set false to work without a database; prod must leave it true.
AUDIT_STRICT=true

# --- LLM (provider-agnostic; M0 ships the OpenAI-compatible client) -----
# Local-first default: Ollama on this machine exposes an OpenAI-compatible API.
# qwen3.5:4b is a *reasoning* model — it spends tokens thinking before it
# answers, so callers must budget max_tokens generously (a 16-token budget
# returns empty content). No API key is required for localhost.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5:4b
# Structured-output steps (JSON) must NOT use a reasoning model: qwen3.5
# burns the whole budget thinking and returns empty content. Any
# non-reasoning local model works; dolphin-llama3:8b is used here.
LLM_JSON_MODEL=dolphin-llama3:8b
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=0.5

# --- Embeddings --------------------------------------------------------
# Local-first: Ollama's nomic-embed-text returns 768 dimensions.
# Must match core.chunks.embedding dimension (migration 0002).
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Evidence -----------------------------------------------------------
# Chunks sent to claim extraction — both the first attempt and the repair
# retry — in relevance order. This is a model trait, not a retrieval knob: the
# deployed local 8B model (dolphin-llama3:8b) has a 4096-token context, and a
# 12-chunk pack measured 4370 prompt tokens on its own. Measured against a real
# Gmail pack: 12 chunks -> invalid JSON / input echoed, finish_reason=length;
# 8 -> valid JSON, 1 claim; 6 -> valid JSON, 6 claims. Raising this only helps
# if the model's context can hold the larger pack.
# EVIDENCE_EXTRACTION_MAX_CHUNKS=6

# --- Orchestrator -------------------------------------------------------
# Evidence candidates per /ask request (retrieval top_k).
# ORCHESTRATOR_TOP_K=12
# Wall-clock ceiling for one question, covering retrieval + the two LLM calls.
# Exceeding it refuses with degraded=true instead of answering on unverified
# text — synthesis is only ever allowed to use verified claims.
# ORCHESTRATOR_BUDGET_S=120

# --- Answer cache (Redis) ----------------------------------------------
# Repeat questions from the SAME user skip the pipeline. Leave REDIS_URL unset
# to disable the cache entirely: the pipeline then runs exactly as it does
# without one, and a Redis outage is never a user-visible failure.
# Keys are per user and per data version — sha256(normalized question |
# user_id | data version), never the question text — and a version bump after
# a sync invalidates every existing entry. The bump is automatic: connector
# sync, /admin/backfill, /admin/seed and POST /admin/cache/invalidate all
# advance it.
# REDIS_URL=redis://localhost:6379/0
# ANSWER_CACHE_TTL_S=900
# ANSWER_CACHE_ENABLED=true

# --- PII scrubbing ------------------------------------------------------
# Salt for audit.redactions.original_hash. The default is dev-only and
# dictionary-attackable: set a unique value before any real data.
# PII_HASH_SALT=
# PII_ENTITIES_ENABLED=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,LOCATION,CREDIT_CARD,ADDRESS,API_KEY,PRIVATE_KEY,DATE_OF_BIRTH
# JSON file of non-person terms that must survive scrubbing; unset = the
# fixture corpus manifest (dev only).
# PII_ALLOWLIST_PATH=

# --- Connectors (read-only; see docs/08-decisions.md) ------------------
# Jira Cloud: create an API token at id.atlassian.com. Secrets belong in the
# environment only — never in this file, code, or tests.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECTS=PHX,ATL
JIRA_JQL_EXTRA=
JIRA_PAGE_SIZE=50

# Notion lands in M2 (typed stub raises NotImplementedError today).
NOTION_DATABASE_IDS=

# Gmail over IMAP with an app password — no OAuth client, no Gmail REST API.
# Create one at Google Account -> Security -> 2-Step Verification -> App
# passwords (2FA must be on). Secrets belong in the environment only: never in
# this file, code, tests, or a commit. The connector is read-only (EXAMINE +
# BODY.PEEK) and only ever reads the labels listed below.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
# Allowlisted labels, comma-separated. Each is read as an IMAP mailbox, so a
# message outside these labels is never ingested. System mailboxes keep their
# Gmail names (e.g. "[Gmail]/All Mail").
GMAIL_LABELS=INBOX
# Messages per IMAP fetch round (1-200).
GMAIL_PAGE_SIZE=50
# Hard cap per label per sync run; the newest messages win. An inbox is a
# firehose otherwise.
GMAIL_MAX_MESSAGES=200

# --- Operator dashboard (/ui, /admin/*) ---------------------------------
# Unset = on in dev/test, off in staging/prod. The dashboard can trigger a
# Jira sync and an embedding backfill, so set ADMIN_ENABLED=false (or leave it
# unset) anywhere the API is reachable by someone other than you.
# ADMIN_ENABLED=true

# --- Sync intervals (seconds) -----------------------------------------
JIRA_SYNC_INTERVAL_S=900
NOTION_SYNC_INTERVAL_S=900
GMAIL_SYNC_INTERVAL_S=1800
# Data older than this is considered stale; the planner may request a live fetch.
SYNC_STALE_AFTER_S=900
